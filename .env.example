# Public site configuration. Never put provider credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Brevo server-side double opt-in adapter. All four required for subscriptions.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# HTTPS page where Brevo sends a confirmed subscriber.
BREVO_REDIRECT_URL=
